# Zyndicate coordination service configuration

# Server
PORT=4000
LOG_LEVEL=info

# Auth
# HMAC secret for signing session JWTs. Use a long random value in production.
JWT_SECRET=change-me-to-a-long-random-secret-value

# Comma-separated list of allowed browser origins.
CORS_ORIGINS=http://localhost:5173

# SQLite database file. Directory is created on boot.
DATABASE_PATH=./data/zyndicate.db

# Rate limiting
RATE_LIMIT_MAX=120
RATE_LIMIT_WINDOW=1 minute
RATE_LIMIT_AUTH_MAX=10

# Optional tribunal public keys (comma-separated ed25519 hex) allowed to rule disputes
# in addition to the mandate evaluator.
TRIBUNAL_KEYS=
